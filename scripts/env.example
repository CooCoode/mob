# Copy to .env and adjust. Read by mobd.sh and exported to mobd.
# Do not commit .env (gitignored).

# Optional: directory for the mobd pid/log files (default: scripts/run).
# RUN_DIR=

# mobd control plane. The script builds bin/mobd if it does not exist.
MOBD_LISTEN=0.0.0.0:8080
MOBD_CODEX_BIN=codex
MOBD_CODEX_WORKDIR=
# Empty (default): Codex uses mobd's built-in actuation server (`mobd mcp`).
# Set only to try an external MCP server instead.
MOBD_MOB_MCP_COMMAND=
# Args for an external MOBD_MOB_MCP_COMMAND (JSON array), for example: ["--flag"]
# MOBD_MOB_MCP_ARGS=[]
# Optional: URL returned to home clients for the view-only page.
MOBD_VNC_VIEW_URL=
# Comma-separated Tauri/browser origins. Override for a deployed home client.
MOBD_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
# Tasks running at once; the rest queue for the desktop.
MOBD_MAX_RUNNING=1
# Optional: model IDs offered in the App's model picker (comma-separated).
MOBD_MODELS=
# Optional: root for artifacts/ (default: directory of the state file).
# MOBD_DATA_DIR=
# VNC server relayed by mobd's GET /vnc and checked by /health (macOS Screen Sharing).
MOBD_VNC_ADDR=127.0.0.1:5900
# Optional: absolute path to the mobd binary (default: bin/mobd).
# MOBD_BIN=
