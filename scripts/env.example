# Copy to .env and adjust. Used by all scripts in this directory.
# Do not commit .env (gitignored).

# Where macOS Screen Sharing (or another RFB server) listens.
# Same Mac as the bridge: usually 127.0.0.1 and the local VNC port (commonly 5900 — verify).
VNC_HOST=127.0.0.1
VNC_PORT=5900

# WebSocket listen address for svnc / apps/mob (VNC_WS_URL=ws://HOST:PORT/).
# Prefer loopback or LAN-only bind; put VPN/WSS in front for off-LAN access.
WS_LISTEN_HOST=0.0.0.0
WS_LISTEN_PORT=6080

# Optional: VNC Auth password for Screen Sharing (RFB). Not passed to websockify;
# home clients (svnc / apps/mob) use it as credentials.password. Leave empty if unused.
VNC_PASSWORD=

# Optional: absolute path to websockify binary. Empty = search PATH, then python3 -m websockify.
WEBSOCKIFY_BIN=

# Optional: directory for VNC and mobd pid/log files (default: scripts/run).
# RUN_DIR=

# mobd control plane. The script builds bin/mobd if it does not exist.
MOBD_LISTEN=0.0.0.0:8080
MOBD_CODEX_BIN=codex
MOBD_CODEX_WORKDIR=
# Default: services/mob-mcp/.venv/bin/mob-mcp when present, otherwise mob-mcp on PATH.
MOBD_MOB_MCP_COMMAND=
# Optional JSON array, for example: ["--flag"]
MOBD_MOB_MCP_ARGS=[]
# Optional: URL returned to home clients for the view-only page.
MOBD_VNC_VIEW_URL=
# Comma-separated Tauri/browser origins. Override for a deployed home client.
MOBD_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost
# Tasks running at once; the rest queue for the desktop.
MOBD_MAX_RUNNING=1
# Optional: model IDs offered in the App's model picker (comma-separated).
MOBD_MODELS=
# Optional: root for artifacts/ (default: directory of the state file).
# MOBD_DATA_DIR=
# Optional: VNC host:port for the /health readiness check (usually VNC_HOST:VNC_PORT).
MOBD_VNC_ADDR=127.0.0.1:5900
# Optional: absolute path to the mobd binary (default: bin/mobd).
# MOBD_BIN=
