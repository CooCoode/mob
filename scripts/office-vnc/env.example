# Copy to .env and adjust. Used by start/stop/status in this directory.
# Do not commit .env (gitignored).

# Where macOS Screen Sharing (or another RFB server) listens.
# Same Mac as the bridge: usually 127.0.0.1 and the local VNC port (commonly 5900 — verify).
VNC_HOST=127.0.0.1
VNC_PORT=5900

# WebSocket listen address for svnc / apps/mob (VNC_WS_URL=ws://HOST:PORT/).
# Prefer loopback or LAN-only bind; put VPN/WSS in front for off-LAN access.
WS_LISTEN_HOST=0.0.0.0
WS_LISTEN_PORT=6080

# Optional: VNC Auth password for Screen Sharing (RFB). Not passed to websockify;
# home clients (svnc / apps/mob) use it as credentials.password. Leave empty if unused.
VNC_PASSWORD=

# Optional: absolute path to websockify binary. Empty = search PATH, then python3 -m websockify.
WEBSOCKIFY_BIN=

# Optional: directory for pid/log (default: scripts/office-vnc/run relative to this tree).
# RUN_DIR=
